# Example configuration. Copy to backend/.env to override defaults when running
# manually (without Docker). Docker Compose sets these via docker-compose.yml.

# --- Database ---
# Default is a local SQLite file (zero setup). For PostgreSQL, uncomment
# psycopg2-binary in backend/requirements.txt and set, e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/jobdb
DATABASE_URL=sqlite:///./jobs.db

# --- Celery / Redis ---
# Redis is the Celery broker (db 0) and result backend (db 1).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- File storage ---
# Where uploaded and generated files live.
STORAGE_DIR=storage

# --- CORS ---
# Origins allowed to call the API from a browser (JSON list).
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
