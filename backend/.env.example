# Copy this file to `.env` and adjust as needed (see app/core/config.py).
# A .env file is OPTIONAL — the defaults below run on SQLite with zero setup.

# Application
DEBUG=false

# Database (SQLAlchemy URL).
# Default: a local SQLite file created next to where you run the app.
DATABASE_URL=sqlite:///./jobs.db

# To use PostgreSQL instead:
#   1. uncomment psycopg2-binary in requirements.txt and reinstall
#   2. comment out the SQLite line above and use one like:
# DATABASE_URL=postgresql+psycopg2://jobuser:jobpass@localhost:5432/jobdb

# --- Celery / Redis (Phase 2) ---
# Redis is the Celery broker (db 0) and result backend (db 1).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Seconds the simulated work sleeps for inside process_job.
JOB_SIMULATED_DURATION_SECONDS=10
